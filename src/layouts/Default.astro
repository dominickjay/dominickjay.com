---
import { getImagePath } from "astro-opengraph-images";
import Base from "./Base.astro";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const { url, site } = Astro;
const ogImage = getImagePath({ url, site });
---

<Base title={title} description={description} image={ogImage}>
  <main>
    <article>
      <div
        class="pt-[32px] md:pt-[64px]"
        style="--grid-placement: 12; --gutter: 43px;"
      >
        <slot />
      </div>
    </article>
  </main>
</Base>
