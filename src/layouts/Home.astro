---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Cursor from "../components/Cursor.astro";
import { getImagePath } from "astro-opengraph-images";
import { getPublicationAtUri } from "@bryanguffey/astro-standard-site";
import { ATPROTO_DID, PUBLICATION_RKEY } from "../lib/atproto-config";

const { url, site } = Astro;
const ogImage = getImagePath({ url, site });

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const publicationUri = getPublicationAtUri(ATPROTO_DID, PUBLICATION_RKEY);
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      showName={false}
      description={description}
      image={ogImage}
    />
		<link rel="site.standard.publication" href={publicationUri}>
  </head>

  <body>
    <Cursor />
    <slot />
  </body>
  <script
    data-goatcounter="https://dominickjay.goatcounter.com/count"
    async
    src="//gc.zgo.at/count.js"
  ></script>
  <script>
    import { initStaggerReveal } from "../utils/stagger-reveal.js";
    initStaggerReveal();
  </script>
</html>
