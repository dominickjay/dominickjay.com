---
import { getPublicationAtUri } from "@bryanguffey/astro-standard-site";
import BaseHead from "../components/BaseHead.astro";
import Cursor from "../components/Cursor.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ATPROTO_DID, PUBLICATION_RKEY } from "../lib/atproto-config";

type Props = {
  title: string;
  description: string;
  showName?: boolean;
  image?: string;
  publication?: boolean;
};

const {
  title,
  description,
  showName = true,
  image,
  publication = false,
} = Astro.props;
const publicationUri = getPublicationAtUri(ATPROTO_DID, PUBLICATION_RKEY);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} showName={showName} image={image} />
    {publication && <link rel="site.standard.publication" href={publicationUri} />}
    <slot name="head" />
  </head>

  <body>
    <Cursor />
    <Header />
    <slot />
    <Footer />
    <slot name="after" />
    <script
      data-goatcounter="https://dominickjay.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
