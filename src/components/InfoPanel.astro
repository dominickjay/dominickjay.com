  class="info-panel"
  x-data="{ active: 'music' }"
  x-cloak
  aria-label="Now listening and reading"
>
  <div class="info-panel__toggles" role="tablist" aria-label="Status type">
    <button
      type="button"
      class="info-panel__toggle is-active"
      role="tab"
      id="info-panel-tab-music"
      aria-controls="info-panel-status-music"
      aria-selected="true"
      :aria-selected="active === 'music'"
      :class="{ 'is-active': active === 'music' }"
      @click="active = 'music'"
    >
      <span class="visually-hidden">Listening</span>
      <div
        class:list={[
          "np-bars np-pill--transparent",
          { "is-playing": isPlaying },
        ]}
        data-info-panel-music-bars
      >
        <div class="np-bar"></div>
        <div class="np-bar"></div>
        <div class="np-bar"></div>
        <div class="np-bar"></div>
        <div class="np-bar"></div>
      </div>
    </button>
