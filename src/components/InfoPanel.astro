---
import {
  getRecentTracksWithTags,
  type LastFmTrack,
} from "../lib/lastfm";

let currentlyReading: Array<{
  book: {
    title: string;
    contributions: Array<{ author: { name: string } }>;
  };
}> = [];

const apiKey = import.meta.env.LAST_FM_API_KEY;
const hardcoverToken = (import.meta.env.HARDCOVER_TOKEN ?? "").trim();
let book = "No book currently reading";
let author = "Unknown author";

const CACHE_TTL = 30000;
const cache = new Map<string, { data: any; expires: number }>();

function getCached(key: string): any | null {
  const cached = cache.get(key);
  if (cached && cached.expires > Date.now()) return cached.data;
  cache.delete(key);
  return null;
}

function setCached(key: string, data: any): void {
  cache.set(key, { data, expires: Date.now() + CACHE_TTL });
}

async function hardcoverGraphQL(query: string, variables: any, useAuth = false) {
  if (useAuth && !hardcoverToken) {
    throw new Error(
      "Hardcover token is required for authenticated requests. " +
        "Please set the hardcoverToken environment variable. " +
        "Get your token from https://hardcover.app/account/api",
    );
  }

  const cacheKey = JSON.stringify({ query, variables });
  const cached = getCached(cacheKey);
  if (cached) {
    return cached;
  }

  const headers: Record<string, string> = {
    "Content-Type": "application/json",
    "User-Agent": "dominickjay.com/1.0",
  };

  if (useAuth) {
    headers["authorization"] = hardcoverToken.startsWith("Bearer ")
      ? hardcoverToken
      : `Bearer ${hardcoverToken}`;
  }

  const response = await fetch("https://api.hardcover.app/v1/graphql", {
    method: "POST",
    headers,
    body: JSON.stringify({ query, variables }),
  });

  if (!response.ok) {
    const errorText = await response.text();
    console.error("GraphQL Error response:", errorText);
    if (response.status === 429) {
      console.warn(
        "Rate limited! Consider waiting 60 seconds or using cached responses.",
      );
    }
    throw new Error(
      `HTTP error! status: ${response.status}, message: ${errorText}`,
    );
  }

  const json = await response.json();
  setCached(cacheKey, json);
  return json;
}

try {
  const currentDataAndList = await hardcoverGraphQL(
    `query getCurrentReadingAndList {
      me {
        user_books(where: { status_id: { _eq: 2 } }) {
          rating
          book {
            id
            title
            contributions {
              author {
                name
              }
            }
          }
        }
      }
    }`,
    {},
    true,
  );

  currentlyReading = currentDataAndList.data.me[0].user_books || [];
  const activeBook = currentlyReading[1]
    ? currentlyReading[1].book
    : currentlyReading[0]?.book;
  if (activeBook) {
    book = activeBook.title ?? "No book currently reading";
    author =
      activeBook.contributions?.[0]?.author?.name ?? "Unknown author";
  }
} catch (error) {
  console.error(error);
}

let recentTracks: LastFmTrack | null = null;

const recentTracksData = await getRecentTracksWithTags(apiKey, 5);

if (recentTracksData.recentTracks) {
  recentTracks = recentTracksData.recentTracks;
}

const trackName = recentTracks?.name ?? "";
const artistName = recentTracks?.artist?.["#text"] ?? "";
const nowPlayingAttr = recentTracks?.["@attr"]?.nowplaying;
const isPlaying =
  nowPlayingAttr === true || String(nowPlayingAttr) === "true";
const bookLabel = `${book} by ${author}`;
---

<div
  class="info-panel"
  x-data="{ active: 'music' }"
  x-cloak
  aria-label="Now listening and reading"
>
  <div class="info-panel__toggles" role="tablist" aria-label="Status type">
    <button
      type="button"
      class="info-panel__toggle is-active"
      role="tab"
      id="info-panel-tab-music"
      aria-controls="info-panel-status-music"
      aria-selected="true"
      :aria-selected="active === 'music'"
      :class="{ 'is-active': active === 'music' }"
      @click="active = 'music'"
    >
      <span class="visually-hidden">Listening</span>
      <div
        class:list={[
          "np-bars np-pill--transparent",
          { "is-playing": isPlaying },
        ]}
        data-info-panel-music-bars
      >
        <div class="np-bar"></div>
        <div class="np-bar"></div>
        <div class="np-bar"></div>
        <div class="np-bar"></div>
        <div class="np-bar"></div>
      </div>
    </button>
    <button
      type="button"
      class="info-panel__toggle"
      role="tab"
      id="info-panel-tab-book"
      aria-controls="info-panel-status-book"
      aria-selected="false"
      :aria-selected="active === 'book'"
      :class="{ 'is-active': active === 'book' }"
      @click="active = 'book'"
    >
      <span class="visually-hidden">Reading</span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path
          d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
        ></path>
      </svg>
    </button>
  </div>

  <div class="info-panel__status marquee">
    <div
      class="info-panel__marquee"
      id="info-panel-status-music"
      role="tabpanel"
      aria-labelledby="info-panel-tab-music"
      x-show="active === 'music'"
      :aria-hidden="active !== 'music'"
      data-info-panel-music
    >
        <div class="marquee__content">
            <span class="info-panel__marquee-item">
                <span data-track-name>{trackName || "Nothing playing"}</span>
                {" "}by{" "}
                <span data-artist-name>{artistName || "—"}</span>
            </span>
            <span class="info-panel__marquee-item" aria-hidden="true">
                <span data-track-name>{trackName || "Nothing playing"}</span>
                {" "}by{" "}
                <span data-artist-name>{artistName || "—"}</span>
            </span>
        </div>
        <div class="marquee__content">
            <span class="info-panel__marquee-item" aria-hidden="true">
                <span data-track-name>{trackName || "Nothing playing"}</span>
                {" "}by{" "}
                <span data-artist-name>{artistName || "—"}</span>
            </span>
            <span class="info-panel__marquee-item" aria-hidden="true">
                <span data-track-name>{trackName || "Nothing playing"}</span>
                {" "}by{" "}
                <span data-artist-name>{artistName || "—"}</span>
            </span>
        </div>
    </div>
    <div
      class="info-panel__marquee"
      id="info-panel-status-book"
      role="tabpanel"
      aria-labelledby="info-panel-tab-book"
      x-show="active === 'book'"
      :aria-hidden="active !== 'book'"
      style="display: none"
    >
        <div class="marquee__content">
            <span class="info-panel__marquee-item">{bookLabel}</span>
            <span class="info-panel__marquee-item" aria-hidden="true">{bookLabel}</span>
        </div>
        <div class="marquee__content">
            <span class="info-panel__marquee-item" aria-hidden="true">{bookLabel}</span>
            <span class="info-panel__marquee-item" aria-hidden="true">{bookLabel}</span>
        </div>
    </div>
  </div>
</div>

<script>
  type RecentTrack = {
    name?: string;
    artist?: { "#text"?: string };
    "@attr"?: { nowplaying?: boolean | string };
  } | null;

  const POLL_INTERVAL_MS = 90000;
  let abortController: AbortController | null = null;

  function isNowPlaying(track: RecentTrack): boolean {
    return (
      track?.["@attr"]?.nowplaying === true ||
      String(track?.["@attr"]?.nowplaying) === "true"
    );
  }

  function updateMusicRows(track: RecentTrack) {
    if (!track) return;

    const trackName = track?.name ?? "";
    const artistName = track?.artist?.["#text"] ?? "";
    const nowPlaying = isNowPlaying(track);

    document
      .querySelectorAll<HTMLElement>("[data-info-panel-music]")
      .forEach((row) => {
        row.querySelectorAll<HTMLElement>("[data-track-name]").forEach((el) => {
          el.textContent = trackName || "Nothing playing";
        });
        row.querySelectorAll<HTMLElement>("[data-artist-name]").forEach((el) => {
          el.textContent = artistName || "—";
        });
      });

    document
      .querySelectorAll<HTMLElement>("[data-info-panel-music-bars]")
      .forEach((bars) => {
        bars.classList.toggle("is-playing", nowPlaying);
      });
  }

  async function fetchLatestTrack() {
    abortController?.abort();
    abortController = new AbortController();

    try {
      const response = await fetch("/api/recent-tracks", {
        cache: "no-store",
        signal: abortController.signal,
      });
      const data = await response.json();
      const list = data?.recenttracks?.track;
      const latestTrack =
        Array.isArray(list) && list.length > 0 ? list[0] : null;

      updateMusicRows(latestTrack);
    } catch (error: unknown) {
      if (error instanceof DOMException && error.name === "AbortError") return;
    }
  }

  if (!(window as any).__infoPanelMusicPollerInitialized) {
    (window as any).__infoPanelMusicPollerInitialized = true;
    fetchLatestTrack();
    setInterval(fetchLatestTrack, POLL_INTERVAL_MS);
  }
</script>
