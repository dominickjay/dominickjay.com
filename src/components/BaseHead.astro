---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  showName?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  showName = true,
  image = "/seo-image.png",
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title} {showName == true ? "| Dom Jay" : ""}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />

<script is:inline>
  (function () {
    var hour = new Date().getHours();
    var period;
    if (hour >= 5 && hour < 9) period = "early-morning";
    else if (hour >= 9 && hour < 12) period = "late-morning";
    else if (hour >= 12 && hour < 15) period = "early-afternoon";
    else if (hour >= 15 && hour < 17) period = "mid-afternoon";
    else if (hour >= 17 && hour < 19) period = "last-afternoon";
    else if (hour >= 19 && hour < 22) period = "evening";
    else period = "night";
    document.documentElement.dataset.time = period;
  })();
</script>

<script>
  import collapse from "@alpinejs/collapse";
  import { initScramble } from "../utils/scramble.js";
  document.addEventListener("DOMContentLoaded", initScramble);

  document.addEventListener("alpine:init", () => {
    // @ts-ignore
    const Alpine = window.Alpine;
    if (Alpine) {
      Alpine.plugin(collapse);
    }
  });
</script>
