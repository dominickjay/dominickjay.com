---
import FormattedDate from "./FormattedDate.astro";
const {
  title,
  tags,
  pubDate,
  lastModified,
  id,
  i,
  theme = "default",
  external = "false",
  basePath = "/writing",
} = Astro.props;
---

<li
  class="item"
  {...external === "false" ? {
    "data-topics": tags?.join(",") ?? "",
    "data-title": title?.toLowerCase() ?? ""
  } : {}}
>
  <a
  	href={external === "false" ? `${basePath}/${id}/` : id}
  	class={`link ${theme != "default" ? "link--" + theme : ""}`}
    {...external == "true" ? { target: "_blank", rel: "noopener noreferrer" } : {}}
    data-small={theme === "small"}
    data-narrow={theme === "narrow"}
  >
  	{i &&
    	<span class="index">{i}</span>
    }
    <div class="body">
      <span class="title">{title}</span>
      {pubDate &&
	      <div class="meta">
          <div class="meta__item">
            <FormattedDate date={pubDate} />
            {tags?.length > 0 &&
              <span class="topics">{tags.join(", ")}</span>
            }
          </div>
	      </div>
      }
    </div>
  </a>
</li>
