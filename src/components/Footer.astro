---
import { MAIN_NAVIGATION, EXTERNAL_NAVIGATION } from "../consts";
import { getLatestTrack } from "../lib/lastfm";
import { getCurrentlyReadingBook } from "../lib/hardcover";
import { getPublishedNotes, navWithoutNotes } from "../utils/notes";
import { getVisiblePosts } from "../utils/posts";

const rawPosts = await getVisiblePosts();
const notes = await getPublishedNotes();
const mainNav = navWithoutNotes(MAIN_NAVIGATION, notes.length > 0);
const lastTendedDate = new Date(
  rawPosts.length > 0
    ? Math.max(
        ...rawPosts.map((p) => (p.data.updatedDate ?? p.data.pubDate).valueOf()),
      )
    : Date.now(),
);

const [latestTrack, currentBook] = await Promise.all([
  getLatestTrack(import.meta.env.LAST_FM_API_KEY),
  getCurrentlyReadingBook(import.meta.env.HARDCOVER_TOKEN),
]);

const listeningTrack = latestTrack?.name ?? "";
const listeningArtist = latestTrack?.artist ?? "";
const readingTitle = currentBook?.title ?? "";
const readingAuthor = currentBook?.author ?? "";
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner container">

    <div class="footer-body">
      <div class="footer-nav-grid">
        <nav class="footer-nav-group" aria-label="Pages">
          <p class="footer-nav-label eyebrow">Pages</p>
          <ul class="footer-nav-list">
            {
              mainNav.map((item) => (
                <li>
                  <a class="footer-nav-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav class="footer-nav-group" aria-label="Social">
          <p class="footer-nav-label eyebrow">Social</p>
          <ul class="footer-nav-list">
            {
              EXTERNAL_NAVIGATION.map((item) => (
                <li>
                  <a
                    class="footer-nav-link"
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="footer-nav-link footer-nav-link--rss" href="/rss.xml">
                <svg
                  class="rss-icon"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"
                    stroke-linecap="round"></path>
                  <circle cx="5" cy="19" r="1" fill="currentColor"></circle>
                </svg>
                RSS
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="footer-right">
        <div
          class="now-widget"
          id="footer-now-widget"
          aria-live="polite"
          aria-label="Now: listening and reading"
        >
          <div class="now-slides">
            <div
              class="now-slide is-active"
              id="now-slide-listening"
              role="tabpanel"
              aria-labelledby="now-tab-listening"
              aria-hidden="false"
            >
              <p class="now-label eyebrow">Listening</p>
              <p class="now-value">
                {listeningTrack || "—"}
              </p>
              <p class="now-subtext">{listeningArtist || "—"}</p>
            </div>
            <div
              class="now-slide"
              id="now-slide-reading"
              role="tabpanel"
              aria-labelledby="now-tab-reading"
              aria-hidden="true"
            >
              <p class="now-label eyebrow">Reading</p>
              <p class="now-value">
                {readingTitle || "—"}
              </p>
              <p class="now-subtext">{readingAuthor || "—"}</p>
            </div>
          </div>
          <div class="now-tabs" role="tablist">
            <button
              type="button"
              class="now-tab"
              role="tab"
              id="now-tab-listening"
              aria-selected="true"
              aria-controls="now-slide-listening"
            >
              <span class="sr-only">Listening</span>
            </button>
            <button
              type="button"
              class="now-tab"
              role="tab"
              id="now-tab-reading"
              aria-selected="false"
              aria-controls="now-slide-reading"
            >
              <span class="sr-only">Reading</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span class="footer-tagline">Leave it better than you found it.</span>
        <span class="footer-copyright"
          >© {new Date().getFullYear()} Dominick Jay</span
        >
      </div>
      <div class="footer-bottom-right">
        <span class="footer-last-tended-label">Last tended</span>
        <time
          class="footer-last-tended-value"
          datetime={lastTendedDate.toISOString().slice(0, 10)}
        >
          {
            lastTendedDate.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "short",
              year: "numeric",
              timeZone: "UTC",
            })
          }
        </time>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-bg: var(--color-dark);
    --footer-muted: rgba(251, 248, 239, 0.5);
    --footer-text: rgba(251, 248, 239, 0.65);
    --footer-heading: rgba(251, 248, 239, 0.88);
    --footer-hover: #fbf8ef;

    background: var(--footer-bg);
    color: var(--footer-text);
  }

  .footer-inner {
    padding: var(--space-m) var(--space-m) var(--space-l);
    margin-inline: auto;
  }




  .footer-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    margin-block-end: var(--space-l);
    padding-block-start: var(--space-l);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  .footer-nav-label,
  .now-label {
    color: color-mix(in srgb, var(--accent) 60%, var(--color-light));
    margin-block-end: 8px;
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav-list li {
    margin-block-end: var(--space-xs);
  }

  .footer-nav-link {
    font-family: var(--font-base);
    color: var(--color-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav-link:hover {
    color: color-mix(in srgb, var(--color-light) 80%, transparent);
  }

  .footer-nav-link--rss {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .rss-icon {
    flex-shrink: 0;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    justify-content: space-between;
    min-height: 120px;
  }

  .now-widget {
    flex-shrink: 0;
  }

  .now-slides {
    position: relative;
    min-height: 4rem;
  }

  .now-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .now-slide.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .now-value {
    font-family: var(--font-base);
    font-style: italic;
    color: var(--footer-heading);
    margin: 0 0 var(--space-xs);
  }

  .now-subtext {
    font-family: var(--font-base);
    font-size: 0.85rem;
    font-weight: normal;
    color: color-mix(in srgb, var(--color-light) 60%, transparent);
    margin: 0;
  }

  .now-tabs {
    display: flex;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
  }

  .now-tab {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    background: var(--footer-muted);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;

    &::before {
      content: none;
    }
  }

  .now-tab[aria-selected="true"] {
    background: var(--footer-heading);
  }

  .now-tab:hover {
    background: var(--footer-text);
  }



  .footer-bottom {
    border-top: 1px solid rgba(251, 248, 239, 0.08);
    padding-block-start: var(--space-m);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-m);
    font-size: 0.85rem;
  }

  .footer-bottom-left {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
  }

  .footer-tagline {
    font-family: var(--font-base);
    font-style: italic;
    color: var(--footer-text);
  }

  .footer-copyright {
    font-family: var(--font-base);
    font-weight: normal;
    color: var(--footer-text);
  }

  .footer-bottom-right {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .footer-last-tended-label {
    color: var(--footer-muted);
  }

  .footer-last-tended-value {
    color: var(--footer-text);
  }

  @media (max-width: 700px) {
    .footer-body {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-bottom-right {
      order: 2;
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .footer-nav-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    const widget = document.getElementById("footer-now-widget");
    if (!widget) return;

    const slides = widget.querySelectorAll(".now-slide");
    const tabs = widget.querySelectorAll(".now-tab");
    const INTERVAL = 5000;
    let current = 0;
    let timer = null;

    function show(index) {
      current = index;
      slides.forEach(function (s, i) {
        s.classList.toggle("is-active", i === index);
        s.setAttribute("aria-hidden", i === index ? "false" : "true");
      });
      tabs.forEach(function (t, i) {
        t.classList.toggle("is-active", i === index);
        t.setAttribute("aria-selected", i === index ? "true" : "false");
      });
    }

    function next() {
      show((current + 1) % 2);
    }

    function start() {
      timer = setInterval(next, INTERVAL);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    widget.addEventListener("mouseenter", stop);
    widget.addEventListener("mouseleave", start);
    widget.addEventListener("focusin", stop);
    widget.addEventListener("focusout", start);

    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () {
        show(i);
        stop();
        start();
      });
    });

    start();
  })();
</script>
