---
const { title, description, lastModified, updatedDate } = Astro.props;
const date = lastModified ?? updatedDate;
const formattedDate =
  date &&
  date.toLocaleDateString("en-us", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<header>
  <div
    class="container cluster relative"
    style="--cluster-vertical-alignment: flex-end; --gutter: 32px;"
  >
    <div class="flow" style="--flow-space: var(--space-m)">
      {
        date && (
          <div class="last-updated" data-scramble-on-load>
            <span data-scramble=`Last updated: ${formattedDate}` aria-hidden="true" />
            <span class="sr-only">
              Last updated:
              <time datetime={date.toISOString()}>{formattedDate}</time>
            </span>
          </div>
        )
      }
      <h1
        class="h1 gradient-text md:max-w-[85vw]"
        style="--flow-space: var(--space-l)"
      >
        {title}
      </h1>
      {description &&
      	<h2 class="intro">{description}</h2>
      }
    </div>
  </div>
</header>
