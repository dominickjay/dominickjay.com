---
import FYIBlock from '../../components/FYIBlock.astro';
---

<section class="target-text demo flow">

  <div class="demo__intro">
    <p class="">
      Click a heading below to highlight it in the passage — instantly, no reload.
    </p>
  </div>

  <FYIBlock type="info">
		<span slot="title">Small caveat here</span>
		<div slot="body">This uses the CSS Custom Highlight API rather than a real
	    <span class="u-mono">#:~:text=</span> navigation, which is the only way to
	    fake what <span class="u-mono">::target-text</span> does without a page load
	    in between each click.</div>
  </FYIBlock>

  <section class="example-copy" aria-label="Sample article passage">
    <p id="passage">
      Enhancing navigation means guiding readers precisely to the information
      they came for, rather than leaving them to scan an entire page. Improving
      readability means making it unmistakably clear which content is being
      referenced by a link. Boosting accessibility means giving people who
      navigate by keyboard or assistive technology a clear, visible landing
      point — not just a change in scroll position they may not perceive at all.
    </p>
  </section>

  <div class="stacked" style="--gutter: var(--space-s)">
    <span class="eyebrow" id="controls-label">Jump to a term</span>
    <div class="cluster" role="group" aria-labelledby="controls-label">
      <button class="button" type="button" data-target="navigation">Navigation</button>
      <button class="button" type="button" data-target="readability">Readability</button>
      <button class="button" type="button" data-target="accessibility">Accessibility</button>
    </div>

    <div class="cluster">
      <label for="custom-term" class="sr-only">Or type your own text to highlight</label>
      <input
        id="custom-term"
        class="demo__input"
        type="text"
        placeholder="Or type your own phrase from the passage…"
      />
      <button class="button" type="button" id="custom-apply">Highlight</button>
    </div>
  </div>

  <p class="u-visually-hidden" role="status" id="status"></p>

  <div id="fallback-note" hidden>
    <FYIBlock type="warning">
    	<span slot="title">No support here</span>
    	<div slot="body">Your browser doesn't support the CSS Custom Highlight API, so this demo can't run — the passage above is shown unhighlighted instead.</div>
    </FYIBlock>
  </div>

</section>

<style>

  /* This is the pseudo-element the whole demo exists to show off */
  ::highlight(feature-target) {
    background: color-mix(in srgb, var(--color-feature) 35%, transparent);
    color: var(--color-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }
</style>

<script>
  (function () {
    const passage = document.getElementById('passage');
    const buttons = Array.from(document.querySelectorAll('.button[data-target]'));
    const customInput = document.getElementById('custom-term');
    const customApply = document.getElementById('custom-apply');
    const status = document.getElementById('status');
    const fallbackNote = document.getElementById('fallback-note');

    // Feature detect first — this API isn't universal.
    if (!('highlights' in CSS)) {
      fallbackNote.hidden = false;
      buttons.forEach((btn) => (btn.disabled = true));
      customInput.disabled = true;
      customApply.disabled = true;
      return;
    }

    const highlight = new Highlight();
    CSS.highlights.set('feature-target', highlight);

    function escapeRegExp(string) {
      return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightText(term) {
      highlight.clear();
      const trimmed = term.trim();
      if (!trimmed) return;

      const textNode = passage.firstChild;
      const fullText = textNode.textContent;

      // Source HTML wraps across lines, so textContent contains newlines
      // and runs of indentation spaces that a single literal space in the
      // search term won't match. Treat any whitespace in the term as "one
      // or more whitespace characters" instead of a literal space.
      const pattern = trimmed.split(/\s+/).map(escapeRegExp).join('\\s+');
      const match = new RegExp(pattern, 'i').exec(fullText);

      if (!match) {
        status.textContent = `"${term}" wasn't found in the passage.`;
        return;
      }

      const range = new Range();
      range.setStart(textNode, match.index);
      range.setEnd(textNode, match.index + match[0].length);
      highlight.add(range);

      status.textContent = `Highlighted "${term}" in the passage.`;
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) => b.removeAttribute('data-active'));
        button.setAttribute('data-active', 'true');
        highlightText(button.dataset.target);
      });
    });

    customApply.addEventListener('click', () => {
      buttons.forEach((b) => b.removeAttribute('data-active'));
      highlightText(customInput.value.trim());
    });

    customInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        customApply.click();
      }
    });
  })();
</script>
