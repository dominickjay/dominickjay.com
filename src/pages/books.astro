---
import Base from "../layouts/Base.astro";
import BookItem from "../components/BookItem.astro";
import { getImagePath } from "astro-opengraph-images";
import { getBookshelf } from "../lib/hardcover";

const hardcoverToken = import.meta.env.HARDCOVER_TOKEN;

if (!(hardcoverToken ?? "").trim()) {
  console.warn(
    "Warning: hardcoverToken environment variable is not set. " +
      "Authenticated requests will fail. " +
      "Get your token from https://hardcover.app/account/api",
  );
}

const { backlog, currentlyReading, currentListBooks, allBooks } =
  await getBookshelf(hardcoverToken);

const getListBookUserBook = (listBook) => listBook?.book?.user_books?.[0] ?? null;
const getListBookStatus = (listBook) =>
  getListBookUserBook(listBook)?.user_book_status?.slug;
const getPrimaryAuthor = (book) =>
  book?.contributions?.[0]?.author?.name || "Unknown Author";

const readCount = currentListBooks.filter(
  (book) => getListBookStatus(book) === "read",
);
const currentlyReadingListBooks = currentListBooks
  ?.slice()
  .reverse()
  .filter((book) => getListBookStatus(book) === "currently-reading");
const queuedListBooks = currentListBooks?.filter((book) => {
  const status = getListBookStatus(book);
  return status !== "currently-reading" && status !== "read";
});

let booksByYear = allBooks.reduce((acc, entry) => {
  entry.user_book_reads?.forEach((read) => {
    if (!read.finished_at) return;

    const year = new Date(read.finished_at).getFullYear();
    if (!acc[year]) acc[year] = [];

    // Prevent duplicate titles in the same year
    if (acc[year].some((b) => b.title === entry.book.title)) return;

    acc[year].push({
      id: entry.book.id,
      title: entry.book.title,
      author: getPrimaryAuthor(entry.book),
      finished: read.finished_at,
    });
  });
  return acc;
}, {});

const sortedYears = Object.keys(booksByYear).sort((a, b) => Number(b) - Number(a));

const totalReadCount = allBooks.filter((entry) =>
  entry.user_book_reads?.some((read) => read.finished_at),
).length;

const goalTotal = currentListBooks?.length ?? 0;
const goalPct = goalTotal
  ? Math.round((readCount.length / goalTotal) * 100)
  : 0;
const toGo = Math.max(0, goalTotal - readCount.length);

const { url, site } = Astro;
const ogImage = getImagePath({ url, site });
const year = new Date().getFullYear()
---

<Base
  title="What I'm reading"
  description="Books I've read, books I'm reading, and the occasional one I keep meaning to get to. No summaries, just the list."
  image={ogImage}
>
    <main>
      <div
        class="container flex flex-col md:flex-row gap-[32px] md:gap-[64px] py-[var(--space-m)] md:py-[var(--space-l)] md:!max-w-[992px]"
        style="--grid-placement: 12; --gutter: 43px;"
      >
        <div class="flex flex-col gap-[32px] w-full relative">
          <section
            class="reading-goal-hero"
            style={`--_pct: calc(${readCount.length} / ${goalTotal || 1} * 100%)`}
          >
            <div class="reading-goal-hero__main">
              <div class="reading-goal-hero__progress-wrap">
                <div class="reading-goal-hero__progress-meta">
                  <span>{goalPct}% complete</span>
                  <span>{toGo} to go</span>
                </div>
                <div
                  class="reading-goal-hero__progress-track"
                  aria-hidden="true"
                >
                  <div class="reading-goal-hero__progress-fill"></div>
                </div>
                <p class="reading-goal-hero__summary">
                  {readCount.length} books read this year - {toGo} more to hit the
                  goal.
                </p>
              </div>
            </div>
            <div class="reading-goal-hero__stats">
              <div class="reading-goal-hero__stat">
                <span>
                  {currentlyReading.length}
                </span>
                <span class="reading-goal-hero__stat-label eyebrow">
                  Currently reading
                </span>
              </div>
              <div class="reading-goal-hero__stat">
                <span>{backlog.length}</span
                >
                <span class="reading-goal-hero__stat-label eyebrow">In backlog</span>
              </div>
              <div class="reading-goal-hero__stat">
                <span>
                  {totalReadCount}
                </span>
                <span class="reading-goal-hero__stat-label eyebrow">All time read</span>
              </div>
            </div>
          </section>
          <div class="flex flex-col gap-[20px]">
            <h2 class="h2 col-span-full mb-[24px]">Currently Reading</h2>
            <ol class="feature-list flow" style="--flow-space: 0;">
              {
                currentlyReadingListBooks.map((book) => {
                  const userBook = getListBookUserBook(book);
                  const status = getListBookStatus(book);

                  return (
                    <BookItem
                      title={book.book.title}
                      author={getPrimaryAuthor(book.book)}
                      rating={book.book.rating}
                      cover={book.book.cover}
                      started={userBook?.user_book_reads?.[0]?.started_at}
                      finished={userBook?.user_book_reads?.[0]?.finished_at}
                      status={status}
                      showStrikethrough={status === "read"}
                    />
                  );
                })
              }
            </ol>
          </div>

          {queuedListBooks.length > 0 && (
            <div class="flex flex-col gap-[20px]">
                <h2 class="h2 col-span-full mb-[24px]">{year} Reading List</h2>
              <ol class="feature-list flow" style="--flow-space: 0;">
                {
                  queuedListBooks.map((book, i) => {
                    const userBook = getListBookUserBook(book);
                    const status = getListBookStatus(book);

                    return (
                      <BookItem
                        i={String(i + 1).padStart(2, "0")}
                        title={book.book.title}
                        author={getPrimaryAuthor(book.book)}
                        rating={book.book.rating}
                        cover={book.book.cover}
                        queued={status === "read"}
                        started={userBook?.user_book_reads?.[0]?.started_at}
                        finished={userBook?.user_book_reads?.[0]?.finished_at}
                        status={status}
                        showStrikethrough={status === "read"}
                      />
                    );
                  })
                }
              </ol>
            </div>
          )}

          {
            sortedYears.map((year, i) => (
              <ul class="col-span-full">
                <li>
                  {i === 0 ? (
                    <div class="flex flex-col mt-[var(--space-xs)]">
                      <h2 class="h2">
                        Books read in {year}{" "}
                        <span class="text-[20px] opacity-75">
                          ({booksByYear[year].length})
                        </span>
                      </h2>
                      <ol
                        class="feature-list flow max-md:mx-[-16px] mt-[var(--space-m)]"
                        style="--flow-space: 0;"
                      >
                        {booksByYear[year].map((book, i) => (
                          <BookItem
                            i={String(i + 1).padStart(2, "0")}
                            title={book.title}
                            author={book.author}
                          />
                        ))}
                      </ol>
                    </div>
                  ) : (
                    <details class="flex flex-col">
                      <summary class="h2 cursor-pointer list-none">
                        <span>
                          Books read in {year}{" "}
                          <span class="text-[20px] opacity-75">
                            ({booksByYear[year].length})
                          </span>
                        </span>
                      </summary>
                      <ol
                        class="feature-list flow max-md:mx-[-16px] mt-[var(--space-m)]"
                        style="--flow-space: 0;"
                      >
                        {booksByYear[year].map((book, i) => (
                          <BookItem
                            i={String(i + 1).padStart(2, "0")}
                            title={book.title}
                            author={book.author}
                          />
                        ))}
                      </ol>
                    </details>
                  )}
                </li>
              </ul>
            ))
          }
          <ul class="col-span-full">
            <li>
              <div
                class="flex flex-col gap-y-[var(--space-s)] md:gap-y-[var(--space-m)]"
              >
                <h2 class="h2">
                  Backlog{" "}
                </h2>
                <ol
                  class="feature-list flow max-md:mx-[-16px]"
                  style="--flow-space: 0;"
                >
                  {
                    backlog.map((book, i) => (
                      <BookItem
                        i={String(i + 1).padStart(2, "0")}
                        key={book.book.id}
                        title={book.book.title}
                        author={getPrimaryAuthor(book.book)}
                        rating={book.book.rating}
                        cover={book.book.cover}
                      />
                    ))
                  }
                </ol>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </main>
</Base>
