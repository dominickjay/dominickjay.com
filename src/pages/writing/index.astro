---
import Base from "../../layouts/Base.astro";
import PatternBanner from "../../components/Pattern-Banner.astro";
import FeatureListItem from "../../components/FeatureListItem.astro";
import { SITE_DESCRIPTION, EXTERNAL_WRITING } from "../../consts";
import { getVisiblePosts, sortByPubDateDesc } from "../../utils/posts";
import FormattedDate from "../../components/FormattedDate.astro";
import DefaultHero from "../../components/DefaultHero.astro";
import { getImagePath } from "astro-opengraph-images";

let externalPosts = EXTERNAL_WRITING;

let randomSuperhero = "";
const superheroes = [
	"Batman", "Wolverine", "Gambit", "Iron Man", "Spider-Man", "90s Cartoon Superhero Bananaman", "Captain Planet", "Colin Robinson",
];
randomSuperhero = superheroes[Math.floor(Math.random() * superheroes.length)];

const posts = sortByPubDateDesc(await getVisiblePosts());

// Extract all unique tags from posts
const allTags = posts.flatMap((post) => post.data.tags);
const categories = [...new Set(allTags)].sort();
const tagCounts = Object.fromEntries(
	categories.map((tag) => [
		tag,
		posts.filter((post) => post.data.tags?.includes(tag)).length,
	]),
);
const postLength = posts.length;

const { url, site } = Astro;
const ogImage = getImagePath({ url, site });
---

<Base
	title="From the Desk of Dom Jay"
	showName={false}
	description={SITE_DESCRIPTION}
	image={ogImage}
	publication
>
		<main>
			<DefaultHero
				title="From the Desk"
				description={`${postLength} posts about CSS, career anxiety, and the slow realisation that knowing more just reveals how much more there is to know. Also: not ${randomSuperhero}.`}
			/>
			<PatternBanner />
			<section
				class="container flow"
				x-data={`{
					category: 'All',
					categoryOptions: ${JSON.stringify(categories)},
				}`}
			>
				<div class="!grid grid-cols-4 gap-[var(--space-m)]">
					<div class="col-span-full md:col-span-3 max-md:w-full shrink-0 flex max-md:flex-col md:items-end gap-[var(--space-m)] pt-[var(--space-m)] md:pt-[var(--space-xl)]">
						<div class="flex items-center gap-x-[var(--space-m)] justify-between w-full">
							<div class="flex-1 h-full">
								<div class="search-wrap">
									<span class="search-icon">⌕</span>
									<input type="text" class="search-input" id="searchInput" placeholder="Search posts…" autocomplete="off" spellcheck="false">
								</div>
							</div>
							<span class="results-count" id="resultsCount">35 posts</span>
						</div>
					</div>
					<div class="col-span-full md:col-span-3">
						<ol class="!pb-[56px] feature-list flow" data-internal-posts style="--flow-space: 0;">
							{
								posts.map((post: any, i: number) => (
									<FeatureListItem
										i={String(i + 1).padStart(2, "0")}
										title={post.data.title}
										description={post.data.description}
										tags={post.data.tags}
										pubDate={post.data.pubDate}
										lastModified={post.lastModified}
										id={post.id}
										external="false"
									/>
								))
							}
							<li id="emptyState" class="hidden col-span-full py-[var(--space-xl)] text-center opacity-70" aria-live="polite">
								No posts match your filters.
							</li>
						</ol>
						<div class="stacked">
							<h3 class="eyebrow">Writing elsewhere</h3>
							<ol class="!pb-[56px] feature-list flow" data-external-posts style="--flow-space: 0;">
								{
									externalPosts.map((post: any, i: number) => (
										<FeatureListItem
											title={post.label}
											id={post.href}
											external="true"
										/>
									))
								}
								<li id="emptyState" class="hidden col-span-full py-[var(--space-xl)] text-center opacity-70" aria-live="polite">
									No posts match your filters.
								</li>
							</ol>
						</div>
					</div>
					<div
						class="col-span-full md:col-span-1 relative"
					>
						<div class="md:sticky md:top-[120px]">
							<span class="h3" data-category=""> Topics </span>
							<div id="sideTopics" class="flex max-md:flex-wrap md:flex-col gap-[var(--space-s)] pt-[var(--space-m)] md:max-h-[70vh] md:overflow-auto">
								<button
									class="category-filter w-fit"
									data-category="All"
									@click.prevent={`category = 'All'`}
									:class="{ active: category === 'All' }"
								>
									all
								</button>
								{
									categories.map((category) => (
										<button
											class="category-filter lowercase w-fit"
											data-category={category}
											@click.prevent={`category = '${category}'`}
											:class={`{ 'active': category === '${category}' }`}
										>
											<span data-scramble={category}>{category}</span>
											<span class="opacity-60">({tagCounts[category]})</span>
										</button>
									))
								}
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
</Base>

<script>
		import { initStaggerReveal } from "../../utils/stagger-reveal.js";
		let searchQuery = '';

		const internalList = document.querySelector("[data-internal-posts]");
		const section = internalList?.closest("section.container.flow");
		const getItems = () =>
			internalList ? internalList.querySelectorAll(".item") : [];

		function applyFilters() {
		  const items = getItems();
		  const activeTopic = section?.querySelector('.category-filter.active')?.dataset.category ?? 'All';
		  let visible = 0;
		  items.forEach(item => {
		    const topicOk  = activeTopic === 'All' || (item.dataset.topics || '').split(',').map(t => t.trim()).includes(activeTopic);
		    const searchOk = !searchQuery || (item.dataset.title || '').includes(searchQuery.toLowerCase());

		    const show = topicOk && searchOk;
		    item.classList.toggle('hidden', !show);

		    if (show) {
		      item.classList.remove('visible');
		      setTimeout(() => item.classList.add('visible'), visible * 26);
		      visible++;
		    }
		  });

		  const resultsEl = document.getElementById('resultsCount');
		  if (resultsEl) resultsEl.textContent = visible + ' posts';
		  const emptyEl = internalList?.querySelector("#emptyState");
		  if (emptyEl) emptyEl.style.display = visible === 0 ? "block" : "none";
		}

		document.getElementById('searchInput').addEventListener('input', e => {
		  searchQuery = e.target.value.trim();
		  applyFilters();
		});

		section?.addEventListener('click', (e) => {
		  if (e.target.closest('.category-filter')) applyFilters();
		});

		applyFilters();

		initStaggerReveal();
</script>
