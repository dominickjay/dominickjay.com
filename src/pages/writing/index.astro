---
import Base from "../../layouts/Base.astro";
import PatternBanner from "../../components/Pattern-Banner.astro";
import FeatureListItem from "../../components/FeatureListItem.astro";
import { SITE_DESCRIPTION, EXTERNAL_WRITING } from "../../consts";
import { getVisiblePosts, sortByPubDateDesc } from "../../utils/posts";
import FormattedDate from "../../components/FormattedDate.astro";
import DefaultHero from "../../components/DefaultHero.astro";
import { getImagePath } from "astro-opengraph-images";

let externalPosts = EXTERNAL_WRITING;

let randomSuperhero = "";
const superheroes = [
	"Batman", "Wolverine", "Gambit", "Iron Man", "Spider-Man", "90s Cartoon Superhero Bananaman", "Captain Planet", "Colin Robinson",
];
randomSuperhero = superheroes[Math.floor(Math.random() * superheroes.length)];

const posts = sortByPubDateDesc(await getVisiblePosts());

const monthKey = (d: Date) => `${d.getFullYear()}-${d.getMonth()}`;
const monthName = (m: number) =>
	new Date(2000, m, 1).toLocaleString("en-us", { month: "long" });

// Newest-first list of years, each with its months (newest first) that have posts.
const firstOfMonth = new Set<number>();
const seenMonths = new Set<string>();
posts.forEach((post, i) => {
	const key = monthKey(post.data.pubDate);
	if (!seenMonths.has(key)) {
		seenMonths.add(key);
		firstOfMonth.add(i);
	}
});
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))].map(
	(year) => ({
		year,
		months: [
			...new Set(
				posts
					.filter((p) => p.data.pubDate.getFullYear() === year)
					.map((p) => p.data.pubDate.getMonth()),
			),
		],
	}),
);
const postLength = posts.length;

const { url, site } = Astro;
const ogImage = getImagePath({ url, site });
---

<Base
	title="From the Desk of Dom Jay"
	showName={false}
	description={SITE_DESCRIPTION}
	image={ogImage}
	publication
>
		<main>
			<DefaultHero
				title="From the Desk"
				description={`${postLength} posts about CSS, career anxiety, and the slow realisation that knowing more just reveals how much more there is to know. Also: not ${randomSuperhero}.`}
			/>
			<PatternBanner />
			<section
				class="container flow"
			>
				<div class="!grid grid-cols-4 gap-[var(--space-m)]">
					<div class="col-span-full md:col-span-3 pt-[var(--space-m)] md:pt-[var(--space-xl)]">
						<ol class="!pb-[56px] feature-list flow" data-internal-posts style="--flow-space: 0;">
							{
								posts.map((post: any, i: number) => (
									<>
										{firstOfMonth.has(i) && (
											<li
												class="month-heading"
												id={`month-${monthKey(post.data.pubDate)}`}
												data-month={monthKey(post.data.pubDate)}
											>
												<h2 class="eyebrow">
													{monthName(post.data.pubDate.getMonth())} {post.data.pubDate.getFullYear()}
												</h2>
											</li>
										)}
										<FeatureListItem
										i={String(i + 1).padStart(2, "0")}
										title={post.data.title}
										description={post.data.description}
										tags={post.data.tags}
										pubDate={post.data.pubDate}
										lastModified={post.lastModified}
										id={post.id}
										external="false"
										/>
									</>
								))
							}
						</ol>
						<div class="stacked">
							<h3 class="eyebrow">Writing elsewhere</h3>
							<ol class="!pb-[56px] feature-list flow" data-external-posts style="--flow-space: 0;">
								{
									externalPosts.map((post: any, i: number) => (
										<FeatureListItem
											title={post.label}
											id={post.href}
											external="true"
										/>
									))
								}
							</ol>
						</div>
					</div>
					<nav
						class="max-md:hidden md:col-span-1 relative"
						aria-label="Posts by date"
					>
						<div class="date-nav md:sticky md:top-[120px] md:max-h-[70vh] md:overflow-auto pt-[var(--space-xl)]">
							{
								years.map(({ year, months }, yi) => (
									<details open={yi === 0} data-year={year}>
										<summary>{year}</summary>
										<ul>
											{months.map((m) => (
												<li>
													<a class="date-nav__link" href={`#month-${year}-${m}`} data-month-link={`${year}-${m}`}>
														{monthName(m)}
													</a>
												</li>
											))}
										</ul>
									</details>
								))
							}
						</div>
					</nav>
				</div>
			</section>
		</main>
</Base>

<script>
		import { initStaggerReveal } from "../../utils/stagger-reveal.js";

		const internalList = document.querySelector("[data-internal-posts]");
		const getItems = () =>
			internalList ? internalList.querySelectorAll(".item") : [];
		const trackedEls = () =>
			internalList ? internalList.querySelectorAll(".item, .month-heading") : [];
		const monthLinks = document.querySelectorAll("[data-month-link]");

		let activeYear = null;
		function setActiveMonth(key) {
		  monthLinks.forEach(link => {
		    const on = link.dataset.monthLink === key;
		    if (on) link.setAttribute('aria-current', 'true');
		    else link.removeAttribute('aria-current');
		  });
		  const year = key?.split('-')[0];
		  if (year && year !== activeYear) {
		    activeYear = year;
		    // Only the newest year and the year being read stay open.
		    document.querySelectorAll('details[data-year]').forEach((d, i) => {
		      d.open = i === 0 || d.dataset.year === year;
		    });
		  }
		}

		function updateActiveMonth() {
		  const probe = 140;
		  let current = null;
		  trackedEls().forEach(item => {
		    if (item.getBoundingClientRect().top <= probe) current = item.dataset.month;
		  });
		  if (!current) current = trackedEls()[0]?.dataset.month;
		  if (current) {
		    setActiveMonth(current);
		    const monthItems = [...trackedEls()].filter(i => i.dataset.month === current);
		    const top = monthItems[0]?.getBoundingClientRect().top ?? 0;
		    const bottom = monthItems.at(-1)?.getBoundingClientRect().bottom ?? 1;
		    const progress = Math.min(1, Math.max(0, (probe - top) / (bottom - top || 1)));
		    monthLinks.forEach(link => {
		      if (link.dataset.monthLink === current) link.style.setProperty('--progress', progress.toFixed(3));
		      else link.style.removeProperty('--progress');
		    });
		  }
		}

		getItems().forEach((item, i) => {
		  setTimeout(() => item.classList.add('visible'), i * 26);
		});

		window.addEventListener('resize', updateActiveMonth);

		let ticking = false;
		window.addEventListener('scroll', () => {
		  if (ticking) return;
		  ticking = true;
		  requestAnimationFrame(() => { updateActiveMonth(); ticking = false; });
		}, { passive: true });

		updateActiveMonth();

		initStaggerReveal();
</script>
