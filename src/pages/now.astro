---
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, s-maxage=86400",
);

import Layout from "../layouts/Default.astro";
import { getTopTracks } from "../lib/lastfm";
import { getReadingGoal } from "../lib/hardcover";
import { render } from "astro:content";
import { getVisibleNowEntries, sortByPubDateDesc } from "../utils/posts";
import ScrollHeading from "../components/ScrollHeading.astro";

const nowPosts = sortByPubDateDesc(await getVisibleNowEntries());

const currentPost = nowPosts[0];
const pastPosts = nowPosts.slice(1);

function getExcerpt(body: string): string {
  const match = body.match(
    /##\s*Professional\s*\n([\s\S]*?)(?=\n##\s*Hobbies|$)/i,
  );
  const block = match?.[1]?.trim() ?? "";
  const plain = block
    .replace(/\n+/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[*_`#]/g, "")
    .trim();
  const first = plain.match(/^[^.!?]*[.!?]/)?.[0] ?? plain.slice(0, 120);
  return first.trim();
}

const apiKey = import.meta.env.LAST_FM_API_KEY;

const { currentlyReading, booksRead, goalTotal } = await getReadingGoal(
  import.meta.env.HARDCOVER_TOKEN,
);

let topTracks: { name: string; artist: { name?: string; "#text"?: string } }[] = [];
if (apiKey) {
  try {
    const res = await getTopTracks(apiKey, 10, "1month");
    if (res.toptracks?.track) topTracks = res.toptracks.track;
  } catch (err) {
    console.error("[Now] Last.fm:", err);
  }
}

const lastUpdateFormatted = currentPost
  ? currentPost.data.pubDate.toLocaleDateString("en-GB", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : "";

const today = new Date().toISOString().slice(0, 10);

const currentRendered = currentPost
  ? await render(currentPost)
  : { Content: () => null };
const { Content: CurrentContent } = currentRendered;

const pastWithContent = await Promise.all(
  pastPosts.map(async (post) => {
    const { Content } = await render(post);
    const excerpt =
      (post.data as { excerpt?: string }).excerpt ?? getExcerpt(post.body ?? "");
    return { post, Content, excerpt };
  }),
);

const goalPercent =
  goalTotal > 0 ? Math.round((booksRead / goalTotal) * 100) : 0;
---

<Layout
  title="What I'm up to"
  description="What I'm currently working on, reading, and thinking about. Updated irregularly but genuinely."
>
  <article class="container now-page">
    <header class="page-header">
	    <div class="page-header__title">
	      <ScrollHeading title="Now" />
	    </div>
      <div class="page-header__meta">
        {lastUpdateFormatted && (
        <div class="last-updated" data-scramble-on-load>
          <span data-scramble=`Last updated: ${lastUpdateFormatted}` aria-hidden="true" />
          <span class="sr-only">
            Last updated:
            <time datetime={lastUpdateFormatted}>{lastUpdateFormatted}</time>
          </span>
        </div>
        )}
      </div>
    </header>

    <div class="now-layout sidebar" data-reversed>

      <div class="stacked prose now-snapshot" style="--gutter: var(--space-xl)">
       	<div class="stacked" style="--gutter: var(--space-m)">
       		<span class="eyebrow">
		        Currently reading
			    </span>
					<div
		         class="stacked"
		         style="--gutter: var(--space-m)"
		       >
				   	<div class="now-item stacked" style="--gutter: var(--space-s)">
			      	{currentlyReading.slice(0, 2).map((entry) => (
								<div class="stacked" style="--gutter: var(--space-s)">
						      <span class="title">{entry.book.title}</span>
						      <span class="author">
						        {entry.book.contributions?.[0]?.author?.name ?? ""}
						      </span>
								</div>
		          ))}
				   	</div>
					</div>
        </div>
        <div class="stacked" style="--gutter: var(--space-m)">
       		<span class="eyebrow">
         		Top tracks this month
			    </span>
					<div
		         class="stacked"
		         style="--gutter: var(--space-m)"
		      >
	      		<ol class="track-list">
              {topTracks.slice(0, 10).map((track, i) => (
                <li class="track-item">
                  <span class="track-item__name" title={track.name}>
                    {track.name}
                  </span>
                  <span class="track-item__artist">
                    {track.artist?.name ?? track.artist?.["#text"] ?? ""}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
      <main class="now-written">
        {currentPost && CurrentContent && (
          <div class="now-written-content flow prose">
            <CurrentContent tracks={currentPost.data.tracks} pubDate={today} />
          </div>
        )}
      </main>
    </div>

    {pastPosts.length > 0 && (
      <section class="accordion-entries">
        <div class="accordion-entries__header">
          <span class="accordion-entries__title">Previous entries</span>
        </div>
        {pastWithContent.map(({ post, Content, excerpt }) => (
          <details class="past-entry">
            <summary>
              <span class="past-entry__trigger-left">
                <span class="past-entry__date">
                  {post.data.pubDate.toLocaleDateString("en-GB", {
                    month: "short",
                    year: "numeric",
                  })}
                </span>
                <span class="past-entry__excerpt">{excerpt}</span>
              </span>
              <svg
                class="past-entry__icon"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <line
                  x1="8"
                  y1="2"
                  x2="8"
                  y2="14"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <line
                  x1="2"
                  y1="8"
                  x2="14"
                  y2="8"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </summary>
            <div class="past-entry__panel">
              <div class="past-entry__inner">
                <div class="past-entry__content">
                  <Content tracks={post.data.tracks} pubDate={today} />
                </div>
              </div>
            </div>
          </details>
        ))}
      </section>
    )}
  </article>
</Layout>
