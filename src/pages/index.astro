---
export const prerender = true;

import Layout from "../layouts/Home.astro";
import InfoPanel from "../components/InfoPanel.astro";
import GrowthPanel from "../components/GrowthPanel.astro";
import { getVisiblePosts, sortByPubDateDesc } from "../utils/posts";
import InlineHeadingText from "../components/InlineHeadingText.astro";
import { SITE_DESCRIPTION, SITE_TAGLINE } from "../consts";

const posts = sortByPubDateDesc(await getVisiblePosts());
---

<Layout
	{...{
		title: "Dom Jay - CSS, JS, and the occasional existential crisis",
		description:
			"CSS, JavaScript, and the web platform - written honestly, published impatiently, and updated whenever guilt kicks in.",
	} as any}
>
	<main class="grid home container">
		<section>
			<div class="hero grid">
				<div class="hero__content">
					 <InlineHeadingText
						 heading={SITE_TAGLINE}
						 text={SITE_DESCRIPTION}
						 italicIndices={[2, 5]}
					 />

                    <div class="info-panel-wrap">
                        <InfoPanel />
                    </div>
				</div>
			</div>
		</section>

		<section>
			<div class="stacked" style="--gutter: 64px">
				<GrowthPanel posts={posts} />
			</div>
		</section>
	</main>
</Layout>
