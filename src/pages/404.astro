---
export const prerender = false;

import Base from "../layouts/Base.astro";
import NotFound from "../components/NotFound.astro";
import { getPublishedNotes } from "../utils/notes";
import { getVisiblePosts } from "../utils/posts";

function levenshteinDistance(a, b) {
  a = a.toLowerCase();
  b = b.toLowerCase();

  const distances = Array.from({ length: b.length + 1 }, (_, i) => i);

  for (let aIndex = 1; aIndex <= a.length; aIndex++) {
    let previousDistance = aIndex;
    distances[0] = aIndex;

    for (let bIndex = 1; bIndex <= b.length; bIndex++) {
      const oldDistance = distances[bIndex];
      const cost = a[aIndex - 1] === b[bIndex - 1] ? 0 : 1;

      distances[bIndex] = Math.min(
        distances[bIndex] + 1,
        distances[bIndex - 1] + 1,
        previousDistance + cost,
      );

      previousDistance = oldDistance;
    }
  }

  return distances[b.length];
}

const posts = await getVisiblePosts();

const notes = await getPublishedNotes();

const staticRoutes = [
  {
    href: "/books",
    title: "Reading List",
    paths: ["/books", "/reading-list", "/book", "/reading"],
  },
  {
    href: "/music",
    title: "Music",
    paths: ["/music", "/music-list", "/song", "/songs"],
  },
  ...(notes.length > 0
    ? [
        {
          href: "/notes",
          title: "Notes",
          paths: ["/notes", "/note"],
        },
      ]
    : []),
];

const postRoutes = posts.map((post) => ({
  href: `/writing/${post.id}`,
  title: post.data.title,
  paths: [`/writing/${post.id}`],
}));

const noteRoutes = notes.map((note) => ({
  href: `/notes/${note.id}`,
  title: note.data.title,
  paths: [`/notes/${note.id}`],
}));

const possibleRoutes = [...staticRoutes, ...postRoutes, ...noteRoutes];

const requestedPath = Astro.url.pathname;

const recommendedRoute = possibleRoutes
  .flatMap((route) =>
    route.paths.map((path) => ({
      href: route.href,
      title: route.title,
      distance: levenshteinDistance(requestedPath, path),
    })),
  )
  .sort((a, b) => a.distance - b.distance)[0];

const showRecommendation =
  recommendedRoute != null && recommendedRoute.distance <= 8;

---

<Base
  title="Lost? Same."
  description="You found a page that doesn't exist. I probably renamed it and forgot to set up a redirect. Sorry about that."
>
    <main>
      <NotFound>
        {
          showRecommendation && (
            <div class="relative">
              Did you mean <a href={recommendedRoute.href}>{recommendedRoute.title}</a>?
            </div>
          )
        }
      </NotFound>
    </main>
</Base>
